# Nuvapix — tetapan untuk hosting cPanel (Netkl)

# Paksa HTTPS (ciri AI/WebGPU perlukan https://).
# Jika website keluar ralat "too many redirects", padam 3 baris RewriteEngine..RewriteRule di bawah.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

DirectoryIndex index.html

# Jenis fail
AddType application/javascript .js
AddType application/wasm .wasm
AddType application/octet-stream .onnx

# Mampatan
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>

# Jangan cache HTML (supaya kemas kini terus nampak); cache CSS/JS sekejap
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.(onnx|wasm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Sembunyikan fail yang bukan untuk awam
<FilesMatch "\.(md|DS_Store|sqlite|sqlite-wal|sqlite-shm)$">
  Require all denied
</FilesMatch>
